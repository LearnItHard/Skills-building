# MinerU API Configuration
# 获取地址: https://mineru.net/apiManage
MINERU_API_TOKEN=your_token_here

# API v4 端点 (不要修改)
MINERU_API_URL=https://mineru.net/api/v4

# 功能开关
MINERU_ENABLE_FORMULA=true
MINERU_ENABLE_TABLE=true
MINERU_LANGUAGE=ch
MINERU_IS_OCR=false
MINERU_MODEL_VERSION=vlm

# 输出设置
MINERU_OUTPUT_DIR=./output
MINERU_KEEP_TEMP=false

# 重试和轮询设置
MINERU_MAX_RETRIES=3
MINERU_RETRY_DELAY=5
MINERU_TIMEOUT=300
MINERU_POLL_INTERVAL=3
MINERU_MAX_POLL_ATTEMPTS=100
